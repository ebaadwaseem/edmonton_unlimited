{
  "name": "edmonton_unlimited",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node --watch --import tsx server.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:import": "node --import tsx scripts/import-documents.ts",
    "db:index": "node --import tsx scripts/index-document.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:attributions": "node --import tsx scripts/import-verified-attributions.ts",
    "test:review": "REVIEW_INTEGRATION=1 node --import tsx --test tests/review-integration.test.ts",
    "demo:assign": "node --import tsx scripts/assign-demo-application.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "openai": "^7.45.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-pdf": "^11.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
